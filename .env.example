DATABASE_URL=postgres://postgres:postgres@localhost:5432/base?sslmode=disable

# --- OpenTelemetry ---
# Off by default. Set to true to export traces (and logs, see below).
OTEL_ENABLED=false
# Set to "otlp" to also ship logs to the collector. Logs always go to "stdout".
OTEL_LOG_SHIPPING=otlp
# Everything below is a standard OTel variable read by the SDK itself.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SERVICE_NAME=base
# Batching (defaults shown); see the README before changing.
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
# OTEL_BSP_SCHEDULE_DELAY=5000
# OTEL_BSP_EXPORT_TIMEOUT=30000
# OTEL_BLRP_MAX_QUEUE_SIZE=2048
# OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512
# OTEL_BLRP_SCHEDULE_DELAY=1000
# OTEL_BLRP_EXPORT_TIMEOUT=30000
